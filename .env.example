# Copy this file to .env, or run ./init.sh. Never commit .env.
# Core and Deployments checkouts should be siblings by default.
HAYATE_CORE_PATH=../core
HAYATE_DOCKERFILE=../deployments/Dockerfile
HAYATE_API_PORT=8642
# init.sh generates API_SERVER_KEY locally.
API_SERVER_KEY=
# Configure the provider/model in config/models.json and config/hayate-agent.yaml.
MODEL_API_KEY=
# Optional Matrix bot account; leave empty for API-only operation.
MATRIX_HOMESERVER=
MATRIX_USER_ID=
MATRIX_DEVICE_ID=
MATRIX_ACCESS_TOKEN=
# Change this allowlist before enabling Matrix.
MATRIX_ALLOWED_USERS=@owner:example.org
